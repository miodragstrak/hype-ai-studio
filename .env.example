RUNWAY_VIDEO_DURATION_SECONDS=5
RUNWAY_VIDEO_RATIO=1280:720
RUNWAY_CREDIT_USD_RATE=0.01
RUNWAY_MODEL_CREDITS_PER_SECOND=12
RUNWAY_SOFT_LIMIT_USD=10
RUNWAY_HARD_LIMIT_USD=30
RUNWAY_POLL_INTERVAL_SECONDS=5
RUNWAY_TASK_TIMEOUT_SECONDS=900
RUNWAY_DOWNLOAD_TIMEOUT_SECONDS=120
RUNWAY_DOWNLOAD_MAX_BYTES=262144000
MAX_RETRIES=2
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
