DATABASE_URL=postgresql://hype:hype@localhost:5432/hype
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=hype:jobs
STORAGE_ROOT=./.data/storage
MOCK_PROVIDER_DELAY_SECONDS=0.1
MOCK_PROVIDER_FAILURE_MODE=none
VIDEO_PROVIDER=mock
RUNWAYML_API_SECRET=
